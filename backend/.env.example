# ==============================================================================
# Sodio Interest Graph — Backend Environment Configuration
# ==============================================================================

# Application
APP_NAME=SodioInterestGraph
APP_VERSION=1.0.0
APP_DESCRIPTION=Interest Graph Engine - Community Platform
DEBUG=true
LOG_LEVEL=DEBUG

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# NVIDIA NIM API Configuration
# NOTE: LLM/Embedding models are ONLY used for:
#   1. NLP interest-tag extraction from post text
#   2. Semantic embedding generation for interest vectors
# All ranking math, scoring formulas, decay and trust calculations = pure Python
# ==============================================================================
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_MAX_TOKENS=512
NVIDIA_TEMPERATURE=0.1
NVIDIA_REQUEST_TIMEOUT=30

# ==============================================================================
# Database (SQLite for POC — zero infrastructure required)
# Set to postgresql+asyncpg://user:pass@host/db for production
# ==============================================================================
DATABASE_URL=sqlite:///./sodio.db

# ==============================================================================
# Interest Graph — Ranking Weights
# Must sum to 1.0. Tweak per surface in code.
# ==============================================================================
WEIGHT_RELEVANCE=0.30
WEIGHT_TRUST=0.20
WEIGHT_AUTHORITY=0.15
WEIGHT_FRESHNESS=0.15
WEIGHT_PROXIMITY=0.10
WEIGHT_ENGAGEMENT=0.05
WEIGHT_INTENT=0.05

# ==============================================================================
# Signal Decay Parameters
# Lambda controls how fast signals decay: score = exp(-lambda * days)
# Explicit signals (club joins) decay slowly; implicit (views) decay fast
# ==============================================================================
DECAY_LAMBDA_EXPLICIT=0.01
DECAY_LAMBDA_IMPLICIT=0.10
DECAY_LAMBDA_MEDIUM=0.05

# ==============================================================================
# Edge Weight Coefficients (Section 3 of Design Doc)
# edge_weight = (alpha * explicit_base)
#             + (beta  * implicit_score * trust_multiplier)
#             + (gamma * recency_factor)
# ==============================================================================
EDGE_WEIGHT_ALPHA=0.5
EDGE_WEIGHT_BETA=0.3
EDGE_WEIGHT_GAMMA=0.2

# ==============================================================================
# MMR (Maximal Marginal Relevance) Diversity Re-ranking
# lambda=1.0 => pure relevance; lambda=0.0 => pure diversity
# ==============================================================================
MMR_LAMBDA=0.7
DIVERSITY_SLOT_FRACTION=0.20

# ==============================================================================
# Trust Propagation (PageRank-style)
# ==============================================================================
TRUST_DAMPING_FACTOR=0.85
TRUST_PROPAGATION_ITERATIONS=20
TRUST_MIN_SCORE=0.10
TRUST_MAX_SCORE=1.00
VERIFIED_USER_TRUST_BOOST=0.15
VERIFIED_BUSINESS_TRUST_BOOST=0.20

# ==============================================================================
# Feed & Recommendation Settings
# ==============================================================================
DEFAULT_FEED_SIZE=20
MAX_FEED_SIZE=50
COLD_START_THRESHOLD=5
COMMERCIAL_SLOT_FRACTION=0.20
EXPLORE_SLOT_FRACTION=0.10
MAX_HOPS_GRAPH_EXPLORATION=3

# ==============================================================================
# Scoring Penalty
# ==============================================================================
SPAM_RISK_HIGH_PENALTY=0.40
SPAM_RISK_MEDIUM_PENALTY=0.20
VELOCITY_ANOMALY_WINDOW_MINUTES=5
VELOCITY_ANOMALY_THRESHOLD=50
